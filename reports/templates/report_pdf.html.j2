<!DOCTYPE html>
<html>
<head>
    <title>WebGuard Scan Report</title>
    <style>
        body { font-family: Helvetica, sans-serif; font-size: 12px; }
        @page { margin: 1in; }
        .finding { page-break-inside: avoid; margin-bottom: 20px; padding: 15px; border-left: 5px solid; }
        .finding.CRITICAL { border-color: #d9534f; background: #fdf0f0; }
        .finding.HIGH { border-color: #f0ad4e; background: #fcf8e3; }
        .finding.MEDIUM { border-color: #f0ad4e; background: #fcf8e3; }
        .finding.LOW { border-color: #5bc0de; background: #d9edf7; }
        .finding.INFO { border-color: #5cb85c; background: #dff0d8; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f4f4f4; }
    </style>
</head>
<body>
    <h1>WebGuard Security Report</h1>
    <p><strong>Target:</strong> {{ report.target_url }}</p>
    <p><strong>Scan Time:</strong> {{ report.scan_time_utc }}</p>

    <div style="border: 1px solid #ccc; padding: 20px; text-align: center; margin-bottom: 20px;">
        <h2>Overall Score</h2>
        <div style="font-size: 48px; font-weight: bold;">{{ report.score.overall_score }} / 10.0</div>
        <div style="font-size: 24px;">Grade: {{ report.score.overall_grade }} ({{ report.score.overall_label }})</div>
    </div>

    <h2>Dimension Scores</h2>
    <table>
        <tr>
            <th>Dimension</th>
            <th>Score</th>
            <th>Grade</th>
        </tr>
        {% for dim in report.score.dimensions %}
        <tr>
            <td>{{ dim.dimension }}</td>
            <td>{{ dim.score }}</td>
            <td>{{ dim.grade }} ({{ dim.label }})</td>
        </tr>
        {% endfor %}
    </table>

    <h2>Findings</h2>
    {% for result in report.results %}
        {% if not result.passed %}
        <div class="finding {{ result.severity }}">
            <h3>[{{ result.severity }}] {{ result.title }} ({{ result.owasp_id }})</h3>
            <p><strong>Dimension:</strong> {{ result.dimension }}</p>
            <p><strong>Description:</strong> {{ result.description }}</p>
            <p><strong>Business Impact:</strong> {{ result.business_impact }}</p>
            <p><strong>Recommendation:</strong> {{ result.recommendation }}</p>
            <p><strong>Effort:</strong> {{ result.effort }}</p>
        </div>
        {% endif %}
    {% endfor %}
</body>
</html>
