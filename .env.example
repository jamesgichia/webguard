# =============================================================================
# WebGuard — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is in .gitignore.
# Every variable here is required unless marked [optional].
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# Runtime environment
# Values: development | production | testing
WEBGUARD_ENV=development

# Secret key for JWT signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBGUARD_SECRET_KEY=

# JWT algorithm (do not change)
JWT_ALGORITHM=HS256

# Access token expiry in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiry in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection URL (asyncpg driver for FastAPI/SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://webguard:webguard_dev@localhost:5432/webguard

# Synchronous URL used by Alembic migrations only
DATABASE_URL_SYNC=postgresql+psycopg2://webguard:webguard_dev@localhost:5432/webguard

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Maximum number of concurrent scan workers
MAX_CONCURRENT_SCANS=10

# -----------------------------------------------------------------------------
# Scanning limits
# -----------------------------------------------------------------------------

# Total scan timeout in seconds (default: 300 = 5 minutes for Deep profile)
SCAN_TIMEOUT_SECONDS=300

# Per-request HTTP timeout in seconds
MAX_SCAN_TIMEOUT=30

# Maximum response body bytes read (default: 4096 = 4KB)
MAX_RESPONSE_BODY_BYTES=4096

# -----------------------------------------------------------------------------
# Reporting
# -----------------------------------------------------------------------------

# Directory where generated reports (JSON, HTML, PDF) are saved
REPORT_OUTPUT_DIR=./reports

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------

# NVD (National Vulnerability Database) API key — [optional]
# Increases rate limit from 5 req/30s to 50 req/30s.
# Register at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# -----------------------------------------------------------------------------
# CLI connected mode
# -----------------------------------------------------------------------------

# API key for CLI connected mode — set this on the CLIENT machine, not the server
# Generated via the web dashboard: Settings → API Keys → Generate New Key
WEBGUARD_API_KEY=

# API base URL for CLI connected mode (default: production endpoint)
WEBGUARD_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Error monitoring
# -----------------------------------------------------------------------------

# Sentry DSN — [optional in development, required in production]
# Get from: https://sentry.io → Create Project → Python → FastAPI
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Docker Compose (local development only)
# -----------------------------------------------------------------------------

# PostgreSQL service credentials — used by docker-compose.yml
POSTGRES_DB=webguard
POSTGRES_USER=webguard
POSTGRES_PASSWORD=webguard_dev
